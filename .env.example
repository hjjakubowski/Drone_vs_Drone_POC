# Runtime
INZ_ENV=development
INZ_LOG_LEVEL=INFO
INZ_PROJECT_ROOT=.

# Optional path overrides
INZ_CONFIG_DIR=configs
INZ_MODELS_DIR=models/production
INZ_RECORDINGS_DIR=datasets/recordings
INZ_EXPORTS_DIR=datasets/recordings/exports

# Frontend
INZ_UI_THEME=tactical_dark
INZ_START_FULLSCREEN=false

# Backend placeholders
INZ_BACKEND_ENABLED=false
INZ_MODEL_BACKEND=placeholder
